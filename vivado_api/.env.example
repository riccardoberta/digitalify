# Copy this file to .env and fill in the values for your server.
# Use forward slashes in all paths — both Python and Vivado's TCL interpreter
# handle them correctly on Windows as well as Linux/macOS.

# ── Windows (Vivado 2025.1) ────────────────────────────────────────────────
VIVADO_API_VIVADO_PATH=C:/Xilinx/Vivado/2025.1/bin/vivado.bat
VIVADO_API_WORKSPACE_DIR=C:/vivado_api

# ── Linux / macOS ──────────────────────────────────────────────────────────
# VIVADO_API_VIVADO_PATH=/tools/Xilinx/Vivado/2025.1/bin/vivado
# VIVADO_API_WORKSPACE_DIR=/data/vivado_api

# Bearer token for API authentication.
# Clients must send: Authorization: Bearer <token>
# Leave empty (or remove the line) to disable authentication completely.
VIVADO_API_API_KEY=change-me-to-a-strong-secret

# Maximum seconds allowed for a single synthesis run (default: 3600 = 1 hour)
VIVADO_API_SYNTHESIS_TIMEOUT=3600

# Maximum seconds allowed for a single simulation run (default: 600 = 10 min)
VIVADO_API_SIMULATION_TIMEOUT=600
